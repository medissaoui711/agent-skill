{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review finding interchange",
  "type": "object",
  "required": [
    "title",
    "category",
    "severity",
    "file",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "correctness",
        "security",
        "architecture",
        "performance",
        "reliability",
        "maintainability"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    }
  }
}
