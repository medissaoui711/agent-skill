{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public benchmark manifest",
  "type": "object",
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "schemas/case.schema.json"
      }
    }
  }
}
